+  /** The rule for `head` over _seed with nbind bindings, split on H's shape if it
+   * stopped there (RULE_SPLIT): an offset, or 0. */
+  uint32_t derive_rule(uint32_t head, uint32_t nbind) {
+    _hole_shape = -1;
+    uint32_t off = derive_one(head, HOLE, nbind);
+    if (RULE_SPLIT && _stop == 1 && _stop_hole == HOLE) {
+      // Stopped on the argument's shape: one template per shape, each re-derived
+      // from the root with that much known.
+      uint32_t sub[3];
+      sub[0] = derive_one(head, leaf(), nbind);
+      _hole_shape = 1, sub[1] = derive_one(head, HOLE, nbind);
+      _hole_shape = 2, sub[2] = derive_one(head, HOLE, nbind);
+      _hole_shape = -1;
+      if (sub[0] && sub[1] && sub[2]) {
+        off = uint32_t(_pool.size());
+        _pool.insert(_pool.end(), {0, 0, 0, 2, 0, 0, nbind, 0, 0, 0, 0, sub[0], sub[1], sub[2]});
+      }
+    }
+    return off;
+  }
+
+  /** Derive the rule for head `a` into slot h: 0 if it is not worth having. */
+  [[gnu::noinline]] uint32_t derive(Tree a, uint32_t h) {
+    if constexpr (!RULE_COLOC) _rule_count[h] = 0;
+    if (RULE_NEVER) return 0;
+    if (RULE_PROTECT && _rule_age[h] && _rules[h].off) { // the slot's rule has been firing: age it, keep it
+      _rule_age[h] >>= 1;
+      ++stats_counters.rule_protected;
+      return 0;
+    }
+    const uint64_t c0 = __rdtsc();
+    if (_pool.size() > RULE_POOL_MAX) RULE_COMPACT ? compact_rules() : clear_rules();
+    _seed.clear();
+    const uint32_t off = derive_rule(a, 0);
+    _rules[h] = {a, off};
+    if (RULE_PROTECT) _rule_age[h] = 0;
+    if constexpr (RULE_COLOC) _cold[h].rule = 0x80; // the slot holds a rule (or a "none") now
+    if (off) ++stats_counters.rule_derived; else ++stats_counters.rule_negative;
+#ifdef RULE_PROFILE
+    if (off) prof_add(off, a);
+#endif
+    stats_counters.rule_derive_cycles += __rdtsc() - c0;
+    return off;
+  }
+
+  /** Derive the rule for applying any closure the value template at `parent`
+   * builds: its nodes with H renamed to the next binding, the result as the head.
+   * Recorded in the parent's T_CHILD (1 = none). */
+  [[gnu::noinline]] uint32_t derive_child(uint32_t parent) {
+    const uint64_t c0 = __rdtsc();
+    if (_pool.size() > RULE_POOL_MAX) { RULE_COMPACT ? compact_rules() : clear_rules(); return 0; } // parent is gone
+    const uint32_t nbind = _pool[parent + T_NBIND], nn = _pool[parent + T_NN];
+    const uint32_t *pn = _pool.data() + parent + T_HDR;
+    // The seed: the parent's nodes the closure (its result) reaches, renumbered in
+    // order, with the parent's H as the next binding — every seed is then reachable
+    // from the head, which is what lets a firing bind them all by walking it.
+    uint32_t keep[RULE_MAX_NODES + 1];
+    std::fill_n(keep, nn, 0);
+    const auto reach = [&](uint32_t x) { if (x >= NODE0) keep[x - NODE0] = 1; };
+    reach(_pool[parent + T_A]);
+    for (uint32_t k = nn; k-- > 0;)
+      if (keep[k]) reach(pn[2 * k]), reach(pn[2 * k + 1]);
+    uint32_t kept = 0;
+    for (uint32_t k = 0; k < nn; ++k) keep[k] = keep[k] ? NODE0 + kept++ : 0;
+    const auto ren = [&](uint32_t x) { return x == HOLE ? BIND0 + nbind : x >= NODE0 ? keep[x - NODE0] : x; };
+    _seed.clear();
+    for (uint32_t k = 0; k < nn; ++k)
+      if (keep[k]) _seed.push_back(ren(pn[2 * k])), _seed.push_back(ren(pn[2 * k + 1]));
+    const uint32_t off = derive_rule(ren(_pool[parent + T_A]), nbind + 1);
+    _pool[parent + T_CHILD] = off ? off : 1;
+    if (off) ++stats_counters.rule_child_derived; else ++stats_counters.rule_child_negative;
+#ifdef RULE_PROFILE
+    if (off) prof_add(off, 0);
+#endif
+    stats_counters.rule_derive_cycles += __rdtsc() - c0;
+    return off;
+  }
+
+  /** The child rule for a closure with provenance p, deriving it on the
+   * RULE_PROV_THRESH-th application: an offset, or 0. */
+  [[gnu::noinline]] uint32_t prov_rule(uint32_t parent) {
+    if (++_pool[parent + T_CCOUNT] < RULE_PROV_THRESH) return 0;
+    return derive_child(parent);
+  }
+
+  /**
+   * Fire the template at `off` for argument b (and bindings, for a child rule):
+   * build its nodes, push its frames, and return the residual — reduce(a', b') as
+   * a' | b' << 32, or a result r as r (b' = 0).
+   */
+  [[gnu::noinline]] uint64_t fire(uint32_t off, Tree head, Tree b) {
+#ifdef RULE_PROFILE
+    ++_prof[off].fires;
+#endif
+    const uint32_t *t = _pool.data() + off;
+    Tree inst[8 + RULE_MAX_NODES];
+    inst[0] = b;
+    if (t[T_MODE] == 2) {
+      const Node bn = _arena[b];
+      inst[1] = bn.u, inst[2] = bn.v;
+      off = t[T_HDR + (!bn.u ? 0 : !bn.v ? 1 : 2)];
+      t = _pool.data() + off;
+      ++stats_counters.rule_split_fires;
+    }
+    const uint32_t len = t[T_LEN], nn = t[T_NN], nf = t[T_NF], ns = t[T_NSEED];
+    const uint32_t *p = t + T_HDR;
+    const auto res = [&](uint32_t s) { return s & SYM ? inst[s & ~SYM] : s; };
+    if (ns) { // a child rule: bind the head's nodes and the bindings by walking the head
+      inst[8 + ns - 1] = head;
+      for (uint32_t k = ns; k-- > 0;) {
+        const Node x = _arena[inst[8 + k]];
+        if (p[2 * k] & SYM) inst[p[2 * k] & ~SYM] = x.u;
+        if (p[2 * k + 1] & SYM) inst[p[2 * k + 1] & ~SYM] = x.v;
+      }
+      p += 2 * ns;
+    }
+    for (uint32_t k = ns; k < nn; ++k, p += 2) inst[8 + k] = intern(res(p[0]), res(p[1]));
+    const uint32_t s0 = uint32_t(stats_counters.steps) - 1;
+    stats_counters.steps += len - 1;
+    stats_counters.rule_skipped += len - 1;
+    ++stats_counters.rule_fires;
+    stats_counters.rule_nodes += nn;
+    stats_counters.rule_frames += nf;
+    for (uint32_t k = 0; k < nf; ++k, p += 4) _stack.emplace_back(FrameTag(p[0]), res(p[1]), res(p[2]), s0 + p[3]);
+    const Tree r = res(t[T_A]);
+    if (RULE_PROV && t[T_PROV]) { // record the closure: its template, and what it was built from
+      _prov[hash(r, 0) & ((size_t(1) << RULE_PROV_BITS) - 1)] = {r, off};
+      ++stats_counters.rule_prov_records;
+    }
+    return uint64_t(r) | uint64_t(t[T_MODE] ? 0 : res(t[T_B])) << 32;
+  }
