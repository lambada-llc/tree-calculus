+public:
+  /** PROTOTYPE debugging: render the template at `off`, constants named by `name`. */
+  template <typename Name> std::string render_template(uint32_t off, Name name) {
+    const uint32_t *t = _pool.data() + off;
+    const std::function<std::string(uint32_t, int)> show = [&](uint32_t s, int d) -> std::string {
+      if (s == HOLE) return "H";
+      if (s == HOLE_U) return "Hu";
+      if (s == HOLE_V) return "Hv";
+      if (s >= BIND0 && s < NODE0) return "B" + std::to_string(s - BIND0);
+      if (s >= NODE0) {
+        const uint32_t *nd = t + T_HDR + 2 * (s - NODE0);
+        return nd[1] ? "(\u25b3 " + show(nd[0], d) + " " + show(nd[1], d) + ")" : "(\u25b3 " + show(nd[0], d) + ")";
+      }
+      if (s == 1) return "\u25b3";
+      const std::string n = name(s);
+      if (!n.empty()) return n;
+      if (d <= 0) return "#" + std::to_string(s);
+      const Node x = _arena[s];
+      return x.v ? "(\u25b3 " + show(x.u, d - 1) + " " + show(x.v, d - 1) + ")" : "(\u25b3 " + show(x.u, d - 1) + ")";
+    };
+    std::string out = "len=" + std::to_string(t[T_LEN]) + " nodes=" + std::to_string(t[T_NN]) +
+                      (t[T_NSEED] ? " (" + std::to_string(t[T_NSEED]) + " walked from the head)" : "") +
+                      " frames=" + std::to_string(t[T_NF]) + "\n    ";
+    if (t[T_MODE] == 1) out += "value " + show(t[T_A], 2);
+    else out += "reduce(" + show(t[T_A], 2) + ", " + show(t[T_B], 2) + ")";
+    const uint32_t *fr = t + T_HDR + 2 * t[T_NN];
+    for (uint32_t k = t[T_NF]; k-- > 0;) {
+      const uint32_t *f = fr + 4 * k;
+      static const char *tags[] = {"APPLY_TO", "COMPUTE_AND_APPLY", "MEMOIZE", "APPLY_FN"};
+      out += std::string("\n    then ") + tags[f[0]] + "(" + show(f[1], 2) + (f[0] == COMPUTE_AND_APPLY || f[0] == MEMOIZE ? ", " + show(f[2], 2) : "") + ")";
+    }
+    return out + "\n";
+  }
+
+  /** PROTOTYPE debugging: derive the rule for head `a` (an S-step head) and render it,
+   * split on H's shape too if `split`, and — if it is a closure-building value
+   * template — the child (order-1b) rule for every closure it builds. */
+  template <typename Name> std::string describe_rule(Tree a, Name name, bool split = false) {
+    if constexpr (RULES) {
+      const Node an = _arena[a];
+      if (!an.u || !an.v || !_arena[an.u].u || _arena[an.u].v) return "not an S-step head\n";
+      static const char *stops[] = {"value", "needs a hole", "cap", "jet", "head"};
+      _seed.clear();
+      _hole_shape = -1;
+      std::string out;
+      const uint32_t off = derive_one(a, HOLE, 0);
+      out += std::string("  stop=") + stops[_stop] + " " + (off ? render_template(off, name) : "(no rule)\n");
+      if (split) {
+        const char *labels[] = {"  H=\u25b3: ", "  H=\u25b3Hu: ", "  H=\u25b3HuHv: "};
+        for (int sh = 0; sh < 3; ++sh) {
+          _hole_shape = sh ? sh : -1;
+          const uint32_t o = derive_one(a, sh ? HOLE : leaf(), 0);
+          out += std::string(labels[sh]) + "stop=" + stops[_stop] + " " + (o ? render_template(o, name) : "(no rule)\n");
+        }
+        _hole_shape = -1;
+      }
+      if (off && _pool[off + T_PROV]) {
+        const uint32_t child = derive_child(off);
+        out += std::string("  child (any closure it builds, applied to H): stop=") + stops[_stop] + " " +
+               (child ? render_template(child, name) : "(no rule)\n");
+      }
+      return out;
+    }
+    return "";
+  }
