+    for (uint32_t k = 0; k < nodes; ++k)
+      if (keep[k]) _pool.push_back(ren(_tn[2 * k])), _pool.push_back(ren(_tn[2 * k + 1]));
+    for (const SFrame &f : _sst) _pool.insert(_pool.end(), {f.tag, ren(f.a1), ren(f.a2), f.meta});
