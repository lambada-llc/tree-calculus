+#!/bin/bash
+# cachegrind (LL modelled as a 2 MiB L2) over workloads x variants; one summary line each.
+cd "$(dirname "$0")/.."
+out=cg/batch-$(date +%s).txt
+for w in "$@"; do
+  case $w in
+    mixs) cmd=work/mixs.cmd ;;
+    *) cmd=bench/$w.jcmd ;;
+  esac
+  for v in $VARIANTS; do
+    nice -n 10 valgrind --tool=cachegrind --cache-sim=yes --LL=2097152,16,64 --cachegrind-out-file=/dev/null ./bin/drv-$v $cmd > cg/tmp.log 2>&1
+    ir=$(grep "I *refs:" cg/tmp.log | awk '{print $4}')
+    d1=$(grep "D1  misses:" cg/tmp.log | awk '{print $4}')
+    ll=$(grep "LLd misses:" cg/tmp.log | awk '{print $4}')
+    st=$(grep -o "real_steps=[0-9]*\| steps=[0-9]*" cg/tmp.log | tail -1)
+    h=$(grep -o "hash [0-9a-f]*" cg/tmp.log | tail -1)
+    echo "$w $v Ir=$ir D1miss=$d1 L2miss=$ll $st $h" >> $out
+  done
+done
+echo done >> $out
diff -ruN a/implementation/cpp/rules-prototype/bench.py b/implementation/cpp/rules-prototype/bench.py
--- a/implementation/cpp/rules-prototype/bench.py	1970-01-01 00:00:00.000000000 +0000
+++ b/implementation/cpp/rules-prototype/bench.py	2026-10-08 04:52:50.792138970 +0000
@@ -0,0 +1,33 @@
+"""Interleaved best-of-N timing. usage:
+  bench.py N LABEL_REGEX name=binary:cmdfile ...
+Each round runs every config once (in order); ms is the sum of the ms= fields of
+stdout lines matching LABEL_REGEX; hashes ('hash XXXXXXXXXXXXXXXX') must agree."""
+import re, subprocess, sys, statistics, os, resource
+N = int(sys.argv[1]); lab = re.compile(sys.argv[2])
+cfgs = []
+for a in sys.argv[3:]:
+    name, rest = a.split('=', 1); binary, cmd = rest.split(':', 1); cfgs.append((name, binary, cmd))
+times = {c[0]: [] for c in cfgs}; cpu = {c[0]: [] for c in cfgs}; last = {}; hashes = {}; ok = {}
+for r in range(N):
+    for name, binary, cmd in cfgs:
+        r0 = resource.getrusage(resource.RUSAGE_CHILDREN)
+        p = subprocess.run(['nice', '-n', '10', binary, cmd], capture_output=True, text=True)
+        r1 = resource.getrusage(resource.RUSAGE_CHILDREN)
+        cpu[name].append(1000 * (r1.ru_utime - r0.ru_utime + r1.ru_stime - r0.ru_stime))
+        out = p.stdout
+        ms = 0.0; line = ''
+        for l in out.splitlines():
+            if lab.search(l):
+                m = re.search(r' ms=([\d.]+)', l)
+                if m: ms += float(m.group(1)); line = l
+        times[name].append(ms); last[name] = line
+        hashes[name] = tuple(re.findall(r'hash ([0-9a-f]{16})', out))
+        ok[name] = p.returncode == 0 and 'MISMATCH' not in out
+base = min(times[cfgs[0][0]]); cbase = min(cpu[cfgs[0][0]])
+h0 = hashes[cfgs[0][0]]
+for name, *_ in cfgs:
+    t = times[name]
+    ctr = re.sub(r'^\S+ \S+\s+', '', last[name])
+    ctr = re.sub(r' ms=[\d.]+', '', ctr)
+    print(f"{name:14} best={min(t):9.2f}ms med={statistics.median(t):9.2f}ms d={100*(min(t)/base-1):+6.1f}% cpu_best={min(cpu[name]):9.1f}ms cpu_d={100*(min(cpu[name])/cbase-1):+6.1f}% {'OK' if ok[name] else 'FAIL'} {'same-hash' if hashes[name]==h0 else 'HASH-DIFF '+str(hashes[name])} :: {ctr}")
+sys.stdout.flush()
