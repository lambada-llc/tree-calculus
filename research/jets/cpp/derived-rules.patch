+        continue;
+      }
+      if (f.tag == APPLY_TO) {
+        a = result;
+        b = f.a1;
+      } else {
+        _sst.push_back({APPLY_TO, result, 0, 0});
+        a = f.a1;
+        b = f.a2;
+      }
+      goto sreduce;
+    }
+    stop = 0;
+    a = result;
+    b = 0;
+  sresidual:
+    _stop = stop;
+    stats_counters.rule_derive_steps += n;
+    ++stats_counters.rule_stop[stop];
+    if (n < (nbind ? RULE_MIN_LEN_CHILD : RULE_MIN_LEN)) return 0;
+    // Keep only the template nodes the residual reaches; a node's children come before it.
+    const uint32_t nodes = uint32_t(_tn.size() / 2);
+    uint32_t keep[RULE_MAX_NODES + 1];
+    std::fill_n(keep, nodes, 0);
+    const uint32_t nseed = uint32_t(_seed.size() / 2);
+    std::fill_n(keep, nseed, 1); // the head's own nodes stay, in order: firing binds them by walking it
+    const auto reach = [&](uint32_t s) { if (s >= NODE0) keep[s - NODE0] = 1; };
