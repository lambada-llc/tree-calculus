+#ifdef SAMPLER
+// Poor man's sampling profiler: SIGPROF every 0.5 ms of CPU time records the
+// interrupted instruction pointer; the samples are written to $SAMPLES at exit
+// (one hex address per line, relative to the executable's load address).
+#include <signal.h>
+#include <sys/time.h>
+#include <ucontext.h>
+#include <link.h>
+static std::vector<uintptr_t> g_samples;
+static uintptr_t g_base = 0;
+static void on_prof(int, siginfo_t *, void *ctx) {
+  const auto *uc = static_cast<ucontext_t *>(ctx);
+  if (g_samples.size() < g_samples.capacity()) g_samples.push_back(uintptr_t(uc->uc_mcontext.gregs[REG_RIP]));
+}
+static int find_base(struct dl_phdr_info *info, size_t, void *) { if (!g_base) g_base = info->dlpi_addr; return 1; }
+static void start_sampler() {
+  g_samples.reserve(size_t(1) << 24);
+  dl_iterate_phdr(find_base, nullptr);
+  struct sigaction sa{}; sa.sa_sigaction = on_prof; sa.sa_flags = SA_SIGINFO | SA_RESTART; sigaction(SIGPROF, &sa, nullptr);
+  struct itimerval it{{0, 500}, {0, 500}}; setitimer(ITIMER_PROF, &it, nullptr);
+}
+static void stop_sampler() {
+  struct itimerval it{}; setitimer(ITIMER_PROF, &it, nullptr);
+  const char *out = std::getenv("SAMPLES");
+  FILE *f = std::fopen(out ? out : "samples.txt", "w");
+  for (uintptr_t pc : g_samples) std::fprintf(f, "%lx\n", (unsigned long)(pc - g_base));
+  std::fclose(f);
+}
+#endif
